---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { siteConfig } from '../data/site';
import { absoluteExternalArticleUrl } from '../data/external-articles/helpers';
import type { ResolvedExternalArticle } from '../data/external-articles/types';

interface Props {
	article: ResolvedExternalArticle;
}

const { article } = Astro.props;
const articleUrl = absoluteExternalArticleUrl(article.slug);

const articleSchema = {
	'@type': 'Article',
	'@id': `${articleUrl}#article`,
	url: articleUrl,
	headline: article.title,
	description: article.metaDescription,
	datePublished: article.published,
	dateModified: article.updated,
	image: new URL(article.imageSrc, siteConfig.url).href,
	inLanguage: 'en',
	author: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
	publisher: {
		'@type': 'Organization',
		name: siteConfig.name,
		url: siteConfig.url,
		logo: { '@type': 'ImageObject', url: new URL(siteConfig.logoRaster, siteConfig.url).href },
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `${articleUrl}#webpage`,
	},
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	keywords: article.keywords.join(', '),
	articleSection: article.category,
};

const closingHtml = `For more game updates, guides, and related resources, you can also explore <a href="${article.externalUrl}" target="_blank" rel="noopener noreferrer">${article.closingAnchorText}</a>.`;

function pageTitle(headline: string): string {
	const suffix = ` | ${siteConfig.name}`;
	if (headline.length + suffix.length <= 60) return `${headline}${suffix}`;
	if (headline.length <= 60) return headline;
	const trimmed = headline.slice(0, 57);
	const cut = trimmed.lastIndexOf(' ');
	return `${(cut > 40 ? trimmed.slice(0, cut) : trimmed).replace(/[|:–—-]+$/, '').trim()}…`;
}
---

<Layout
	title={pageTitle(article.title)}
	description={article.metaDescription}
	canonicalPath={article.canonicalPath}
	ogImage={article.imageSrc}
	ogImageAlt={article.imageAlt}
	type="article"
	locale="en"
	breadcrumbs={[
		{ label: 'Home', href: '/' },
		{ label: article.game, href: '/' },
		{ label: article.h1 },
	]}
	extraGraph={[articleSchema]}
>
	<Navbar locale="en" />
	<main class="post">
		<div class="shell">
			<div class="shell-content post__inner">
				<article>
					<header class="post__header">
						<p class="post__cat">{article.category}</p>
						<h1>{article.h1}</h1>
						<p class="post__intro">{article.intro}</p>
						<p class="post__meta">
							Published {article.published} · Updated {article.updated}
						</p>
					</header>
					<img
						class="post__hero"
						src={article.imageSrc}
						alt={article.imageAlt}
						width="1200"
						height="675"
						loading="eager"
						decoding="async"
					/>
					{
						article.sections.map((section) => (
							<section class="post__section">
								<h2>{section.h2}</h2>
								{section.paragraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</section>
						))
					}
					<p class="post__closing" set:html={closingHtml} />
				</article>
			</div>
		</div>
	</main>
	<SiteFooter locale="en" />
</Layout>

<style>
	.post {
		padding: 2.5rem 0 4rem;
	}

	.post__inner {
		display: grid;
		gap: 0;
	}

	.post__cat {
		margin: 0 0 0.5rem;
		color: var(--magenta-soft);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.post__header h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		line-height: 1.1;
	}

	.post__intro {
		color: rgba(255, 255, 255, 0.78);
		font-size: 1.08rem;
	}

	.post__meta {
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.85rem;
	}

	.post__hero {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin: 1.5rem 0 2rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.post__section {
		margin-bottom: 1.75rem;
	}

	.post__section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.35rem;
	}

	.post__section p {
		margin: 0 0 0.9rem;
		color: rgba(255, 255, 255, 0.78);
		line-height: 1.7;
	}

	.post__closing {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.65);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.post__closing :global(a) {
		color: var(--magenta-soft);
		text-decoration: none;
		font-weight: 600;
	}

	.post__closing :global(a:hover) {
		text-decoration: underline;
	}
</style>
